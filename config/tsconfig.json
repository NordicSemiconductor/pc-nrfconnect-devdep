{
    "compilerOptions": {
        "types": ["node", "jest", "testing-library__jest-dom"],

        "target": "es2021",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "jsx": "react",

        "strict": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    }
}
